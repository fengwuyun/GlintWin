<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GlintWin</RootNamespace>
    <AssemblyName>GlintWin</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.4.3</Version>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Data/cedict.json"><LogicalName>GlintWin.Bundle/Data/cedict.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Data/Packs/*.json"><LogicalName>GlintWin.Bundle/Data/Packs/%(Filename)%(Extension)</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Data/custom_template.csv"><LogicalName>GlintWin.Bundle/Data/custom_template.csv</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="app.ico"><LogicalName>GlintWin.Bundle/app.ico</LogicalName></EmbeddedResource>
    <None Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- tools/ 下是测试与脚本子工程，不参与主程序编译 -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Content Remove="tools\**" />
  </ItemGroup>

</Project>
